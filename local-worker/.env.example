# Copy to .env and set real values. Never commit .env.

OCTOPUS_SERVER_URL=https://your-instance.octopus.app
# Polling address for Octopus Cloud is usually polling.<your-instance-host>
OCTOPUS_POLLING_ADDRESS=https://polling.your-instance.octopus.app

# An API key for a user who can register workers in the space. Use a short-lived key.
OCTOPUS_API_KEY=API-REPLACE-ME

OCTOPUS_SPACE=Multi-Tenant Testing
WORKER_NAME=mock-worker
WORKER_POOL=Local Container
