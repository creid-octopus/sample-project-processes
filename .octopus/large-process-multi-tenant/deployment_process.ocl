step "deploy-package" {
    name = "Deploy Package"
    package_requirement = "AfterPackageAcquisition"
    properties = {
        Octopus.Action.TargetRoles = "app-server"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                echo SCRIPT-MARKER-deploy-package
            EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }

        packages {
            acquisition_location = "ExecutionTarget"
            feed = "octopus-server-built-in"
            package_id = "sample-app"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "use-build-id" {
    name = "Use Build Id"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                echo SCRIPT-MARKER-use-build-id
                echo "#{Octopus.Action[Core Prep 01].Output.BuildId}"
            EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool = "hosted-ubuntu"
    }
}

